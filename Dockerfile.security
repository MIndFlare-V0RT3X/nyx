# SPDX-License-Identifier: AGPL-3.0-or-later
# Dockerfile.security — the operator-built sandbox image for security
# engagements (Phase 5 §3.1, hard rule #8: pinned, reproducible, no latest).
#
# Build (documented in README.md "Security engagements"):
#   docker build -f Dockerfile.security -t nyx-security:1 .
#
# The image installs the six Phase 5 tools at the pinned versions below.
# Versions are ARGs so operators can pin differently, but they MUST be set:
# an empty ARG fails the build loudly rather than silently floating.
#
# Phase 6: with the egress proxy (docs/EGRESS-PROXY.md), engagement
# sandboxes on this image are LIVE through the kernel-process proxy — every
# outbound connection scope-checked and rate-limited at the CONNECT layer.
# Phase 6.2 adds sqlmap (pinned pip release). Metasploit (msfconsole) is
# OPERATOR-INSTALLED — the official omnibus installer is not a reproducible
# package; see docs/EXPLOITATION.md. Burp runs on the operator's
# workstation behind the egress proxy (docs/EXPLOITATION.md), never in the
# container (a GUI app needs an X11 socket — the exact fd-leak bypass the
# Phase 6.1 bypass suite forbids).
#
# nmap comes from the Debian archive (bookworm ships 7.93 — the upstream
# 7.993 is NOT packaged for this suite; building it from source would need
# the full toolchain, so the distro pin is the reproducible choice here).

FROM debian:12.9-slim

ARG SUBFINDER_VERSION=v2.17.0
ARG HTTPX_VERSION=v1.12.0
ARG NUCLEI_VERSION=v3.11.1
ARG FFUF_VERSION=v2.3.0
ARG KATANA_VERSION=v1.8.0
ARG NMAP_VERSION=7.93+dfsg1-1
ARG SQLMAP_VERSION=1.10.11
ARG TARGETARCH

RUN : "${SUBFINDER_VERSION:?SUBFINDER_VERSION must be pinned}" \
 && : "${HTTPX_VERSION:?HTTPX_VERSION must be pinned}" \
 && : "${NUCLEI_VERSION:?NUCLEI_VERSION must be pinned}" \
 && : "${FFUF_VERSION:?FFUF_VERSION must be pinned}" \
 && : "${KATANA_VERSION:?KATANA_VERSION must be pinned}" \
 && : "${NMAP_VERSION:?NMAP_VERSION must be pinned}" \
 && : "${SQLMAP_VERSION:?SQLMAP_VERSION must be pinned}" \
 && : "${TARGETARCH:?TARGETARCH must be set (buildx provides it)}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      unzip \
      "nmap=${NMAP_VERSION}"       python3-minimal       python3-pip  && rm -rf /var/lib/apt/lists/*

# ProjectDiscovery tools ship prebuilt per-arch zips (version WITHOUT the
# leading v in the asset name; the binary sits at the zip root). ffuf ships
# a tarball containing the bare binary.
RUN case "${TARGETARCH}" in \
      amd64) PDARCH=amd64 ;; \
      arm64) PDARCH=arm64 ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && mkdir -p /tmp/pd /usr/local/bin \
 && curl -fsSL "https://github.com/projectdiscovery/subfinder/releases/download/${SUBFINDER_VERSION}/subfinder_${SUBFINDER_VERSION#v}_linux_${PDARCH}.zip" -o /tmp/pd/subfinder.zip \
 && curl -fsSL "https://github.com/projectdiscovery/httpx/releases/download/${HTTPX_VERSION}/httpx_${HTTPX_VERSION#v}_linux_${PDARCH}.zip" -o /tmp/pd/httpx.zip \
 && curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION#v}_linux_${PDARCH}.zip" -o /tmp/pd/nuclei.zip \
 && curl -fsSL "https://github.com/projectdiscovery/katana/releases/download/${KATANA_VERSION}/katana_${KATANA_VERSION#v}_linux_${PDARCH}.zip" -o /tmp/pd/katana.zip \
 && curl -fsSL "https://github.com/ffuf/ffuf/releases/download/${FFUF_VERSION}/ffuf_${FFUF_VERSION#v}_linux_${PDARCH}.tar.gz" | tar -xz -C /usr/local/bin ffuf \
 && cd /tmp/pd \
 && for z in subfinder httpx nuclei katana; do unzip -o -q "${z}.zip" -d "${z}x"; done \
 && mv subfinderx/subfinder httpxx/httpx nucleix/nuclei katanax/katana /usr/local/bin/ \
 && rm -rf /tmp/pd

# The version checks FAIL the build on mismatch (grep's exit code is the
# check — a wrong or broken binary stops the build).
RUN subfinder -version 2>&1 | grep -q "v${SUBFINDER_VERSION#v}" \
 && httpx -version 2>&1 | grep -q "v${HTTPX_VERSION#v}" \
 && nuclei -version 2>&1 | grep -q "v${NUCLEI_VERSION#v}" \
 && katana -version 2>&1 | grep -q "v${KATANA_VERSION#v}" \
 && ffuf -V | grep -q "version ${FFUF_VERSION#v}" \
 && nmap --version | grep -q "Nmap version ${NMAP_VERSION%%+*}"

# sqlmap: pinned pip release (upstream publishes on PyPI; the pin is the
# release tag). The version check fails the build on mismatch like the rest.
RUN pip3 install --no-cache-dir --break-system-packages "sqlmap==${SQLMAP_VERSION}" \
 && sqlmap --version 2>&1 | grep -q "^${SQLMAP_VERSION}"

# A small default wordlist for ffuf (operators mount their own at
# /workspace/wordlists when they want more).
RUN mkdir -p /opt/wordlists \
 && printf '%s\n' admin backup cgi-bin config console dashboard data db debug dev doc docs download downloads etc files ftp home html images img info js lib login logout media api public register root scripts secret server setup sql static temp test tmp uploads user users var workspace > /opt/wordlists/common.txt

WORKDIR /workspace
