{
  "name": "@nyx/split",
  "version": "0.7.4",
  "description": "NYX \u2014 the Phase 7.3 process split: nyx-kernel (trusted: config, credentials, policy, audit, DB), nyx-agent (semi-trusted: loop, prompts, model), nyx-tools (untrusted: tools, sandbox)",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "nyx-kernel": "./bin/nyx-kernel.js",
    "nyx-agent": "./bin/nyx-agent.js",
    "nyx-tools": "./bin/nyx-tools.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nyx/agent": "workspace:*",
    "@nyx/config": "workspace:*",
    "@nyx/db": "workspace:*",
    "@nyx/ipc": "workspace:*",
    "@nyx/kernel": "workspace:*",
    "@nyx/memory": "workspace:*",
    "@nyx/model": "workspace:*",
    "@nyx/persona": "workspace:*",
    "@nyx/policy": "workspace:*",
    "@nyx/protocol": "workspace:*",
    "@nyx/sandbox": "workspace:*",
    "@nyx/session": "workspace:*",
    "@nyx/tasks": "workspace:*",
    "@nyx/tools": "workspace:*",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8"
  }
}
