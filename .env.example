# NYX environment template.
# Copy to .env and fill in. Keys are read via the env var NAMES declared in
# nyx.config.yaml (providers.<id>.api_key_env). Never put real keys in the repo.

# Owner token used by the server / CLI to authenticate as the owner (R4 approvals).
NYX_OWNER_TOKEN=change-me-local-owner-token

# Example provider keys — reference these names from nyx.config.yaml.
# NYX_ZAI_API_KEY=
# NYX_OPENAI_API_KEY=
# NYX_ANTHROPIC_API_KEY=
# NYX_DEEPSEEK_API_KEY=

# Where NYX keeps its database, memory store, and sandbox workdirs.
# NYX_HOME=/home/you/.nyx

# Runtime environment guard: "development" (default) or "production".
# The local (non-Docker) sandbox refuses to run in production.
# NYX_ENV=development

# Process model (Phase 7.3): "single" (default — one process, byte-identical
# to Phase 6) or "split" (nyx-kernel + nyx-agent + nyx-tools over
# token-authenticated unix sockets; see docs/PROCESS-MODEL.md).
# NYX_PROCESS_MODE=single

# Skip Docker-dependent tests even when Docker is available.
# NYX_SKIP_DOCKER=1
